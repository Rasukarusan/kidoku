generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  collections          Collection[]
  items                Item[]
  itemTemplates        ItemTemplate[]
  mcpGrants            McpGrant[]
  id                   String                @id @default(cuid())
  name                 String?               @unique(map: "uniq_name")
  email                String?               @unique
  emailVerified        DateTime?             @map("email_verified")
  image                String?
  admin                Boolean               @default(false)
  suiAddress           String?               @map("sui_address") @db.VarChar(80)
  accounts             Account[]
  sessions             Session[]
  AiSummaries          AiSummaries[]
  following            Follow[]              @relation("following")
  followers            Follow[]              @relation("followers")
  likes                Like[]
  notifications        Notification[]        @relation("notificationUser")
  actorNotifications   Notification[]        @relation("notificationActor")
  purchases            Purchase[]
  bookComments         BookComment[]
  memoTemplates        MemoTemplate[]
  personalAccessTokens PersonalAccessToken[]
  codexAuth            CodexAuth?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model AiSummaries {
  id       Int       @id @default(autoincrement()) @db.UnsignedInt
  userId   String    @map("user_id")
  sheetId  Int       @map("collection_id")
  analysis Json
  token    Int
  created  DateTime? @default(now()) @db.DateTime(0)
  updated  DateTime? @default(now()) @db.DateTime(0)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_summaries")
}

/// AI分析で使うChatGPTアカウント(Codex)のOAuthトークン。ユーザーごとに1件保持する。
/// access/refresh/id tokenはAES-256-GCMで暗号化してtoken_encに格納する。
model CodexAuth {
  userId    String   @id @map("user_id")
  accountId String?  @map("account_id") @db.VarChar(128)
  tokenEnc  String   @map("token_enc") @db.MediumText
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  created   DateTime @default(now()) @db.DateTime(0)
  updated   DateTime @default(now()) @updatedAt @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("codex_auth")
}

model Follow {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  created     DateTime @default(now()) @db.DateTime(0)
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId], map: "uniq_follower_following")
  @@index([followingId])
  @@map("follows")
}

model Like {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  userId      String?  @map("user_id")
  anonymousId String?  @map("anonymous_id") @db.VarChar(64)
  bookId      Int      @map("item_id") @db.UnsignedInt
  created     DateTime @default(now()) @db.DateTime(0)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  book        Item     @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId], map: "uniq_user_book")
  @@unique([anonymousId, bookId], map: "uniq_anon_book")
  @@index([bookId])
  @@map("likes")
}

model Purchase {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  userId           String   @map("user_id")
  bookId           Int      @map("item_id") @db.UnsignedInt
  txDigest         String   @unique @map("tx_digest") @db.VarChar(120)
  network          String   @default("testnet") @db.VarChar(20)
  amount           String   @db.VarChar(40)
  senderAddress    String   @map("sender_address") @db.VarChar(80)
  recipientAddress String   @map("recipient_address") @db.VarChar(80)
  created          DateTime @default(now()) @db.DateTime(0)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book             Item     @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId], map: "uniq_user_book_purchase")
  @@index([bookId])
  @@map("purchases")
}

model Notification {
  id               Int      @id @default(autoincrement()) @db.UnsignedInt
  userId           String   @map("user_id")
  actorId          String?  @map("actor_id")
  actorAnonymousId String?  @map("actor_anonymous_id") @db.VarChar(64)
  type             String   @db.VarChar(20)
  bookId           Int?     @map("item_id") @db.UnsignedInt
  read             Boolean  @default(false)
  created          DateTime @default(now()) @db.DateTime(0)
  user             User     @relation("notificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor            User?    @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([userId, actorId, type, bookId], map: "uniq_user_actor_type_book")
  @@index([userId])
  @@index([actorId])
  @@map("notifications")
}

model PersonalAccessToken {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  userId     String    @map("user_id")
  name       String    @db.VarChar(60)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(0)
  created    DateTime  @default(now()) @db.DateTime(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_tokens")
}

model MemoTemplate {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  userId    String   @map("user_id")
  name      String   @db.VarChar(120)
  content   String   @db.MediumText
  isDefault Boolean  @default(false) @map("is_default")
  created   DateTime @default(now()) @db.DateTime(0)
  updated   DateTime @default(now()) @db.DateTime(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("memo_templates")
}

model BookComment {
  id      Int      @id @default(autoincrement()) @db.UnsignedInt
  bookId  Int      @map("item_id") @db.UnsignedInt
  userId  String   @map("user_id")
  content String   @db.Text
  created DateTime @default(now()) @db.DateTime(0)
  updated DateTime @default(now()) @db.DateTime(0)
  book    Item     @relation(fields: [bookId], references: [id])
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([userId])
  @@map("item_comments")
}

// MCP clients use the existing Google/NextAuth login for user authentication.
model McpClient {
  id           String   @id @db.VarChar(64)
  name         String   @db.VarChar(120)
  redirectUris Json     @map("redirect_uris")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("mcp_clients")
}

model McpGrant {
  scope             String    @default("books:read") @db.VarChar(40)
  id                String    @id @default(cuid())
  // Either a dynamic registration id or a Client ID Metadata Document URL.
  clientId          String    @map("client_id") @db.VarChar(255)
  clientName        String    @map("client_name") @db.VarChar(120)
  userId            String    @map("user_id")
  codeHash          String?   @unique @map("code_hash") @db.VarChar(64)
  codeChallengeHash String    @map("code_challenge_hash") @db.VarChar(64)
  redirectUriHash   String    @map("redirect_uri_hash") @db.VarChar(64)
  resource          String    @db.VarChar(255)
  codeExpiresAt     DateTime  @map("code_expires_at")
  tokenHash         String?   @unique @map("token_hash") @db.VarChar(64)
  tokenExpiresAt    DateTime? @map("token_expires_at")
  refreshHash       String?   @unique @map("refresh_hash") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
  @@map("mcp_grants")
}

model Collection {
  id          Int                   @id @default(autoincrement()) @db.UnsignedInt
  userId      String                @map("user_id")
  name        String                @db.VarChar(120)
  description String                @db.Text
  position    Int                   @default(1)
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CollectionItem[]
  highlights  CollectionHighlight[]

  @@unique([userId, name], map: "uniq_user_id_name")
  @@map("collections")
}

model ItemType {
  key           String         @id @db.VarChar(40)
  name          String         @db.VarChar(120)
  schemaVersion Int            @default(1) @map("schema_version")
  definition    Json
  items         Item[]
  templates     ItemTemplate[]

  @@map("item_types")
}

model Item {
  id                Int                   @id @default(autoincrement()) @db.UnsignedInt
  userId            String                @map("user_id")
  itemTypeId        String                @map("item_type_id") @db.VarChar(40)
  title             String                @db.VarChar(120)
  imageUrl          String                @default("/no-image.png") @map("image_url") @db.VarChar(255)
  category          String                @default("") @db.VarChar(120)
  rating            String                @default("-") @db.VarChar(5)
  memo              String                @db.MediumText
  isPublicMemo      Boolean               @default(false) @map("is_public_memo")
  isPurchasable     Boolean               @default(false) @map("is_purchasable")
  price             String?               @db.VarChar(40)
  attributes        Json
  attributesVersion Int                   @default(1) @map("attributes_version")
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType          ItemType              @relation(fields: [itemTypeId], references: [key])
  collections       CollectionItem[]
  logs              ItemLog[]
  highlights        CollectionHighlight[]
  likes             Like[]
  purchases         Purchase[]
  bookComments      BookComment[]

  @@index([userId, itemTypeId])
  @@index([itemTypeId])
  @@map("items")
}

model CollectionItem {
  collectionId Int        @map("collection_id") @db.UnsignedInt
  itemId       Int        @map("item_id") @db.UnsignedInt
  position     Int        @default(1)
  addedAt      DateTime   @default(now()) @map("added_at") @db.DateTime(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([collectionId, itemId])
  @@index([itemId])
  @@map("collection_items")
}

model ItemLog {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  itemId     Int       @map("item_id") @db.UnsignedInt
  kind       String    @db.VarChar(40)
  occurredAt DateTime? @map("occurred_at") @db.DateTime(0)
  memo       String    @db.MediumText
  rating     String?   @db.VarChar(5)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  item       Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, occurredAt])
  @@map("item_logs")
}

model ItemTemplate {
  id                Int      @id @default(autoincrement()) @db.UnsignedInt
  userId            String   @map("user_id")
  itemTypeId        String   @map("item_type_id") @db.VarChar(40)
  name              String   @db.VarChar(120)
  title             String   @db.VarChar(120)
  category          String   @db.VarChar(120)
  imageUrl          String   @map("image_url") @db.VarChar(255)
  memo              String   @db.MediumText
  isPublicMemo      Boolean  @default(false) @map("is_public_memo")
  attributes        Json
  attributesVersion Int      @default(1) @map("attributes_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemType          ItemType @relation(fields: [itemTypeId], references: [key])

  @@index([userId, itemTypeId])
  @@index([itemTypeId])
  @@map("item_templates")
}

model CollectionHighlight {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt
  collectionId Int        @map("collection_id") @db.UnsignedInt
  itemId       Int        @map("item_id") @db.UnsignedInt
  position     Int
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([collectionId, position], map: "collection_highlights_collection_position")
  @@index([itemId])
  @@map("collection_highlights")
}
